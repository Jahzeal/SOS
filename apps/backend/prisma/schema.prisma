generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  ADMIN
  BUSINESS
}

enum PhoneCondition {
  NEW
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
  REFURBISHED
  FOR_PARTS
}

enum PhoneStatus {
  IN_STOCK
  SOLD
  IN_REPAIR
  RESERVED
  DISPOSED
  RETURNED
}

enum RepairStatus {
  DIAGNOSING
  WAITING_PARTS
  IN_PROGRESS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  POS
  SPLIT
}

enum CarrierLockStatus {
  UNLOCKED
  CARRIER_LOCKED
}

enum DeviceActivationStatus {
  ACTIVATED
  NOT_ACTIVATED
  READY_FOR_SETUP
}

enum TheftStatus {
  CLEAN
  STOLEN
}

enum TheftReportStatus {
  ACTIVE
  RESOLVED
}

enum QuoteStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

model Business {
  id                        String         @id @default(uuid())
  name                      String
  slug                      String         @unique
  logoUrl                   String?
  address                   String?
  phone                     String?
  email                     String?
  plan                      String         @default("STARTER")
  planId                    String?
  subscriptionPlan          SubscriptionPlan? @relation(fields: [planId], references: [id])
  subscriptionStatus        String         @default("TRIAL")
  trialEndsAt               DateTime?
  subscriptionEndsAt        DateTime?
  paystackCustomerCode      String?
  bankName                  String?
  accountNumber             String?
  accountName               String?
  publicVerificationEnabled Boolean        @default(true)
  customSuccessMessage      String?        @default("This phone is verified and authentic.")
  warrantyTerms             String?
  receiptFooter             String?        @default("Thank you for shopping with us!")
  receiptTerms              String?
  receiptPaperSize          String         @default("80mm")

  // Quote Template Settings
  quoteTitle                String?        @default("PRICE QUOTATION")
  quoteTerms                String?
  quoteNotes                String?
  quoteValidityDays         Int            @default(14)
  quoteAccentColor          String?        @default("#2563EB")
  quoteShowBankDetails      Boolean        @default(true)
  quoteShowSignature        Boolean        @default(true)

  users                     User[]
  phoneRecords              PhoneRecord[]
  customers                 Customer[]
  sales                     Sale[]
  quotes                    Quote[]
  repairs                   RepairTicket[]
  supportTickets            SupportTicket[]
  verificationLogs          VerificationLog[]
  subscriptionPayments      SubscriptionPayment[]

  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
}

model SubscriptionPayment {
  id                  String     @id @default(uuid())
  businessId          String
  business            Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  reference           String     @unique
  amountNgn           Float
  planCode            String
  billingCycle        String     @default("MONTHLY")
  status              String     @default("PENDING")
  channel             String?
  paystackAccessCode  String?
  paidAt              DateTime?
  rawMetadata         Json?

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model SubscriptionPlan {
  id                  String     @id @default(uuid())
  code                String     @unique
  name                String
  description         String?
  monthlyPriceNgn     Float      @default(0)
  annualPriceNgn      Float      @default(0)
  maxDevices          Int        @default(100)
  customBranding      Boolean    @default(false)
  prioritySupport     Boolean    @default(false)
  features            String[]   @default([])
  isActive            Boolean    @default(true)
  isPublic            Boolean    @default(true)
  sortOrder           Int        @default(0)

  businesses          Business[]

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole       @default(BUSINESS)
  businessId    String?
  business      Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  
  refreshTokens RefreshToken[]
  registeredPhones PhoneRecord[]
  quotesCreated Quote[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PhoneRecord {
  id                     String         @id @default(uuid())
  businessId             String
  business               Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  imei1                  String
  imei2                  String?
  serialNumber           String?
  brand                  String
  model                  String
  color                  String?
  storageCapacity        String?
  condition              PhoneCondition @default(NEW)
  status                 PhoneStatus    @default(IN_STOCK)
  
  purchasePrice          Float?
  sellingPrice           Float?
  
  warrantyDurationMonths Int            @default(0)
  warrantyExpiryDate     DateTime?
  qrCodeUrl              String?

  carrierStatus          CarrierLockStatus?
  lockedCarrier          String?
  activationStatus       DeviceActivationStatus?

  isStolen               Boolean                @default(false)
  theftStatus            TheftStatus            @default(CLEAN)
  stolenAt               DateTime?
  theftReason            String?
  theftReportedBy        String?
  lostNote               String?
  contactPhone           String?

  registeredById         String?
  registeredBy           User?          @relation(fields: [registeredById], references: [id], onDelete: SetNull)

  customerId             String?
  customer               Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  repairs                RepairTicket[]
  saleItems              SaleItem[]
  quoteItems             QuoteItem[]

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, brand])
  @@index([isStolen])
  @@index([theftStatus])
  @@index([imei1])
  @@index([imei2])
  @@index([serialNumber])
}

model Customer {
  id           String         @id @default(uuid())
  businessId   String
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name         String
  phone        String
  email        String?
  address      String?
  notes        String?

  phoneRecords PhoneRecord[]
  sales        Sale[]
  quotes       Quote[]
  repairs      RepairTicket[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model RepairTicket {
  id               String       @id @default(uuid())
  ticketNumber     String
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  phoneRecordId    String?
  phoneRecord      PhoneRecord? @relation(fields: [phoneRecordId], references: [id], onDelete: SetNull)

  customerId       String
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  issueDescription String
  technicianNotes  String?
  estimatedCost    Float?
  finalCost        Float?
  status           RepairStatus @default(DIAGNOSING)
  technicianId     String?
  completedAt      DateTime?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Sale {
  id                    String            @id @default(uuid())
  invoiceNumber         String
  receiptNumber         String?           @unique
  businessId            String
  business              Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId            String?
  customer              Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  totalAmount           Float
  discount              Float             @default(0)
  amountPaid            Float             @default(0)
  balanceDue            Float             @default(0)
  paymentMethod         PaymentMethod     @default(CASH)
  paymentStatus         String            @default("PAID") // PAID, PARTIALLY_PAID, CREDIT
  hasInstallments       Boolean           @default(false)
  sendCustomerReminders Boolean           @default(true)
  lastReminderSentAt    DateTime?
  reminderCount         Int               @default(0)
  notes                 String?

  items                 SaleItem[]
  quotes                Quote[]
  installments          SaleInstallment[]
  payments              SalePayment[]
  soldById              String

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model SaleItem {
  id            String       @id @default(uuid())
  saleId        String
  sale          Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  phoneRecordId String?
  phoneRecord   PhoneRecord? @relation(fields: [phoneRecordId], references: [id], onDelete: SetNull)

  description   String
  unitPrice     Float
  quantity      Int          @default(1)
  totalPrice    Float
}

model Quote {
  id                    String              @id @default(uuid())
  quoteNumber           String
  businessId            String
  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId            String?
  customer              Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  quoteDate             DateTime            @default(now())
  expiryDate            DateTime?
  subject               String?

  subtotal              Float
  discount              Float               @default(0)
  taxRate               Float               @default(0)
  taxAmount             Float               @default(0)
  totalAmount           Float
  amountPaid            Float               @default(0)
  balanceDue            Float               @default(0)
  hasInstallments       Boolean             @default(false)
  sendCustomerReminders Boolean             @default(true)
  lastReminderSentAt    DateTime?
  reminderCount         Int                 @default(0)

  status                QuoteStatus         @default(DRAFT)
  notes                 String?
  terms                 String?

  convertedSaleId       String?
  convertedSale         Sale?               @relation(fields: [convertedSaleId], references: [id], onDelete: SetNull)

  items                 QuoteItem[]
  installments          QuoteInstallment[]
  payments              QuotePayment[]
  createdById           String
  createdBy             User                @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([quoteNumber])
}

model QuoteItem {
  id            String       @id @default(uuid())
  quoteId       String
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  phoneRecordId String?
  phoneRecord   PhoneRecord? @relation(fields: [phoneRecordId], references: [id], onDelete: SetNull)

  description   String
  unitPrice     Float
  quantity      Int          @default(1)
  discount      Float        @default(0)
  totalPrice    Float
}

model QuoteInstallment {
  id               String       @id @default(uuid())
  quoteId          String
  quote            Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  installmentNo    Int
  amountDue        Float
  amountPaid       Float        @default(0)
  dueDate          DateTime
  status           String       @default("PENDING") // PENDING, PAID, OVERDUE
  paidAt           DateTime?

  reminderSent     Boolean      @default(false)
  reminderSentAt   DateTime?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([quoteId, status])
  @@index([dueDate, status])
}

model QuotePayment {
  id            String        @id @default(uuid())
  quoteId       String
  quote         Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  amount        Float
  paymentMethod PaymentMethod @default(CASH)
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  receivedById  String?

  createdAt     DateTime      @default(now())
}

model SaleInstallment {
  id               String       @id @default(uuid())
  saleId           String
  sale             Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  installmentNo    Int
  amountDue        Float
  amountPaid       Float        @default(0)
  dueDate          DateTime
  status           String       @default("PENDING") // PENDING, PAID, OVERDUE
  paidAt           DateTime?

  reminderSent     Boolean      @default(false)
  reminderSentAt   DateTime?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([saleId, status])
  @@index([dueDate, status])
}

model SalePayment {
  id            String        @id @default(uuid())
  saleId        String
  sale          Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  amount        Float
  paymentMethod PaymentMethod @default(CASH)
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  receivedById  String?

  createdAt     DateTime      @default(now())
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum NotificationCategory {
  SYSTEM
  SECURITY
  BILLING
  SUPPORT
}

enum NotificationPriority {
  INFO
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id                    String         @id @default(uuid())
  ticketNumber          String         @unique
  businessId            String
  business              Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  requesterName         String
  requesterEmail        String
  requesterPhone        String?
  requesterRole         String?        @default("Staff")
  subject               String
  description           String
  priority              TicketPriority @default(NORMAL)
  status                TicketStatus   @default(OPEN)
  
  relatedImei           String?
  relatedSerial         String?
  relatedVerificationId String?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([businessId])
  @@index([status])
}

model AdminNotification {
  id          String               @id @default(uuid())
  title       String
  message     String
  category    NotificationCategory @default(SYSTEM)
  priority    NotificationPriority @default(NORMAL)
  isRead      Boolean              @default(false)
  actionUrl   String?
  actionLabel String?
  meta        Json?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isRead])
  @@index([category])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model VerificationLog {
  id           String    @id @default(uuid())
  identifier   String
  status       String    // "VERIFIED", "NOT_FOUND", "FLAGGED_STOLEN"
  ipAddress    String?
  userAgent    String?
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([businessId])
}

model TheftReport {
  id                 String            @id @default(uuid())
  imei1              String
  imei2              String?
  serialNumber       String?
  brand              String
  model              String
  color              String?

  ownerEmail         String
  ownerName          String
  ownerPhone         String
  lostNote           String?
  bountyAmount       Float?            @default(0)

  status             TheftReportStatus @default(ACTIVE)
  verificationSource String            @default("GOOGLE_AUTH") // "GOOGLE_AUTH", "PROOF_SCREENSHOT", "POLICE_REPORT"
  proofUrl           String?
  policeCaseNo       String?

  resolvedAt         DateTime?
  resolvedNote       String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([imei1])
  @@index([imei2])
  @@index([serialNumber])
  @@index([ownerEmail])
  @@index([status])
}

model DeviceCheckCache {
  id               String                 @id @default(uuid())
  imei             String                 @unique
  brand            String?
  model            String?
  carrierStatus    CarrierLockStatus?
  lockedCarrier    String?
  activationStatus DeviceActivationStatus?
  source           String                 @default("TAC_PARSER") // "TAC_PARSER", "LIVE_API", "SHOP_VERIFIED"
  rawData          Json?
  expiresAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([imei])
}



