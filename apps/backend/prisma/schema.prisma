generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  ADMIN
  BUSINESS
}

/// What a person may do inside their store. Every store has one OWNER.
enum StoreRole {
  OWNER
  MANAGER
  SALES
  TECHNICIAN
}

enum PhoneCondition {
  NEW
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
  REFURBISHED
  FOR_PARTS
}

/// Where a device in stock came from.
enum DeviceSource {
  PURCHASE
  TRADE_IN
}

/// SWAP: customer swapped a device in at checkout. BUY: store bought it for cash.
enum TradeInKind {
  SWAP
  BUY
}

/// BLOCKED: a swap attempt stopped because the device is reported stolen.
enum TradeInStatus {
  COMPLETED
  BLOCKED
}

enum PhoneStatus {
  IN_STOCK
  SOLD
  IN_REPAIR
  RESERVED
  DISPOSED
  RETURNED
}

enum RepairStatus {
  DIAGNOSING
  WAITING_PARTS
  IN_PROGRESS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  POS
  SPLIT
}

enum CarrierLockStatus {
  UNLOCKED
  CARRIER_LOCKED
}

enum DeviceActivationStatus {
  ACTIVATED
  NOT_ACTIVATED
  READY_FOR_SETUP
}

enum TheftStatus {
  CLEAN
  STOLEN
}

enum TheftReportStatus {
  ACTIVE
  RESOLVED
}

enum QuoteStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

model Business {
  id                        String            @id @default(uuid())
  name                      String
  slug                      String            @unique
  logoUrl                   String?
  address                   String?
  phone                     String?
  email                     String?
  plan                      String            @default("STARTER")
  planId                    String?
  subscriptionPlan          SubscriptionPlan? @relation(fields: [planId], references: [id])
  subscriptionStatus        String            @default("TRIAL")
  trialEndsAt               DateTime?
  subscriptionEndsAt        DateTime?
  paystackCustomerCode      String?
  bankName                  String?
  accountNumber             String?
  accountName               String?
  taxId                     String?
  publicVerificationEnabled Boolean           @default(true)
  customSuccessMessage      String?           @default("This phone is verified and authentic.")
  warrantyTerms             String?
  receiptFooter             String?           @default("Thank you for shopping with us!")
  receiptTerms              String?
  receiptPaperSize          String            @default("80mm")

  // Quote Template Settings
  quoteTitle           String? @default("PRICE QUOTATION")
  quoteTerms           String?
  quoteNotes           String?
  quoteValidityDays    Int     @default(14)
  quoteAccentColor     String? @default("#2563EB")
  quoteShowBankDetails Boolean @default(true)
  quoteShowSignature   Boolean @default(true)

  users                User[]
  phoneRecords         PhoneRecord[]
  customers            Customer[]
  sales                Sale[]
  quotes               Quote[]
  repairs              RepairTicket[]
  supportTickets       SupportTicket[]
  verificationLogs     VerificationLog[]
  subscriptionPayments SubscriptionPayment[]
  branches             Branch[]
  staffInvites         StaffInvite[]
  tradeIns             TradeIn[]

  /// A free Gold store given to a NoxGuarda marketer to show the app to shops.
  isMarketerStore   Boolean            @default(false)
  marketer          Marketer?          @relation("MarketerStore")
  /// The marketer who brought this store in, if any.
  marketerReferrals MarketerReferral[] @relation("ReferredStore")

  // Daily summary email for the owner (and managers, per branch)
  dailySummaryEnabled Boolean  @default(true)
  dailySummaryHour    Int      @default(21) // Lagos time, 0-23
  dailySummaryEmails  String[] @default([])
  lastDailySummaryOn  String? // Lagos date (YYYY-MM-DD) of the last summary sent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A shop location. Every store has one main branch; more depend on the plan.
model Branch {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  phone      String?
  isMain     Boolean  @default(false)
  isActive   Boolean  @default(true)

  users        User[]
  invites      StaffInvite[]
  phoneRecords PhoneRecord[]
  sales        Sale[]
  repairs      RepairTicket[]
  quotes       Quote[]
  tradeIns     TradeIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
}

/// An emailed invitation for a staff member to join a store.
model StaffInvite {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String
  firstName   String
  lastName    String
  storeRole   StoreRole
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  invitedBy   User?     @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([email])
}

model SubscriptionPayment {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  reference          String    @unique
  amountNgn          Float
  planCode           String
  billingCycle       String    @default("MONTHLY")
  status             String    @default("PENDING")
  channel            String?
  paystackAccessCode String?
  paidAt             DateTime?
  rawMetadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  description     String?
  monthlyPriceNgn Float    @default(0)
  annualPriceNgn  Float    @default(0)
  maxDevices      Int      @default(100)
  /// Staff accounts allowed, the owner included. 0 = unlimited.
  maxStaff        Int      @default(1)
  /// Branches allowed, the main branch included. 0 = unlimited.
  maxBranches     Int      @default(1)
  customBranding  Boolean  @default(false)
  prioritySupport Boolean  @default(false)
  features        String[] @default([])
  isActive        Boolean  @default(true)
  isPublic        Boolean  @default(true)
  sortOrder       Int      @default(0)

  businesses Business[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id          String        @id @default(uuid())
  email       String        @unique
  password    String
  firstName   String
  lastName    String
  role        UserRole      @default(BUSINESS)
  businessId  String?
  business    Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  /// Role inside the store. Accounts made at sign-up are the OWNER.
  storeRole   StoreRole     @default(OWNER)
  /// Switched off by the owner: the person can no longer sign in.
  isActive    Boolean       @default(true)
  /// The branch this person works in. Empty = all branches (owners and head-office managers).
  branchId    String?
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invitesSent StaffInvite[] @relation("InvitesSent")

  refreshTokens     RefreshToken[]
  registeredPhones  PhoneRecord[]
  quotesCreated     Quote[]
  tradeInsRecorded  TradeIn[]
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// DeviceCategory enum added
enum DeviceCategory {
  PHONE
  LAPTOP
}

// Update PhoneRecord model

model PhoneRecord {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  imei1           String
  imei2           String?
  serialNumber    String?
  brand           String
  model           String
  color           String?
  storageCapacity String?
  condition       PhoneCondition @default(NEW)
  status          PhoneStatus    @default(IN_STOCK)
  deviceCategory  DeviceCategory @default(PHONE)
  source          DeviceSource   @default(PURCHASE)

  purchasePrice Float?
  sellingPrice  Float?

  warrantyDurationMonths Int       @default(0)
  warrantyExpiryDate     DateTime?
  qrCodeUrl              String?

  carrierStatus    CarrierLockStatus?
  lockedCarrier    String?
  activationStatus DeviceActivationStatus?

  isStolen        Boolean     @default(false)
  theftStatus     TheftStatus @default(CLEAN)
  stolenAt        DateTime?
  theftReason     String?
  theftReportedBy String?
  lostNote        String?
  contactPhone    String?

  registeredById String?
  registeredBy   User?   @relation(fields: [registeredById], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  repairs    RepairTicket[]
  saleItems  SaleItem[]
  quoteItems QuoteItem[]
  tradeIns   TradeIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, brand])
  @@index([isStolen])
  @@index([theftStatus])
  @@index([imei1])
  @@index([imei2])
  @@index([serialNumber])
  @@index([branchId])
}

model Customer {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name    String
  phone   String
  email   String?
  address String?
  notes   String?

  phoneRecords PhoneRecord[]
  sales        Sale[]
  quotes       Quote[]
  repairs      RepairTicket[]
  tradeIns     TradeIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RepairTicket {
  id           String   @id @default(uuid())
  ticketNumber String
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  phoneRecordId String?
  phoneRecord   PhoneRecord? @relation(fields: [phoneRecordId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  issueDescription String
  technicianNotes  String?
  estimatedCost    Float?
  finalCost        Float?
  status           RepairStatus @default(DIAGNOSING)
  technicianId     String?
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}

model Sale {
  id            String   @id @default(uuid())
  invoiceNumber String
  receiptNumber String?
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  totalAmount           Float
  discount              Float         @default(0)
  amountPaid            Float         @default(0)
  balanceDue            Float         @default(0)
  paymentMethod         PaymentMethod @default(CASH)
  paymentStatus         String        @default("PAID") // PAID, PARTIALLY_PAID, CREDIT
  hasInstallments       Boolean       @default(false)
  sendCustomerReminders Boolean       @default(true)
  lastReminderSentAt    DateTime?
  reminderCount         Int           @default(0)
  notes                 String?

  items        SaleItem[]
  quotes       Quote[]
  installments SaleInstallment[]
  payments     SalePayment[]
  soldById     String

  // Value of a device the customer swapped in, taken off what they pay.
  tradeInCredit Float    @default(0)
  tradeIn       TradeIn?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Receipt numbers are sequential per store, so they are unique per store.
  @@unique([businessId, receiptNumber])
  @@index([businessId, createdAt])
  @@index([branchId])
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  phoneRecordId String?
  phoneRecord   PhoneRecord? @relation(fields: [phoneRecordId], references: [id], onDelete: SetNull)

  description String
  unitPrice   Float
  quantity    Int    @default(1)
  totalPrice  Float
}

model Quote {
  id          String   @id @default(uuid())
  quoteNumber String
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  quoteDate  DateTime  @default(now())
  expiryDate DateTime?
  subject    String?

  subtotal              Float
  discount              Float     @default(0)
  taxRate               Float     @default(0)
  taxAmount             Float     @default(0)
  totalAmount           Float
  amountPaid            Float     @default(0)
  balanceDue            Float     @default(0)
  hasInstallments       Boolean   @default(false)
  sendCustomerReminders Boolean   @default(true)
  lastReminderSentAt    DateTime?
  reminderCount         Int       @default(0)

  status QuoteStatus @default(DRAFT)
  notes  String?
  terms  String?

  convertedSaleId String?
  convertedSale   Sale?   @relation(fields: [convertedSaleId], references: [id], onDelete: SetNull)

  items        QuoteItem[]
  installments QuoteInstallment[]
  payments     QuotePayment[]
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([quoteNumber])
  @@index([branchId])
}

model QuoteItem {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  phoneRecordId String?
  phoneRecord   PhoneRecord? @relation(fields: [phoneRecordId], references: [id], onDelete: SetNull)

  description String
  unitPrice   Float
  quantity    Int    @default(1)
  discount    Float  @default(0)
  totalPrice  Float
}

model QuoteInstallment {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  installmentNo Int
  amountDue     Float
  amountPaid    Float     @default(0)
  dueDate       DateTime
  status        String    @default("PENDING") // PENDING, PAID, OVERDUE
  paidAt        DateTime?

  reminderSent   Boolean   @default(false)
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId, status])
  @@index([dueDate, status])
}

model QuotePayment {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  amount        Float
  paymentMethod PaymentMethod @default(CASH)
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  receivedById  String?

  createdAt DateTime @default(now())
}

model SaleInstallment {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  installmentNo Int
  amountDue     Float
  amountPaid    Float     @default(0)
  dueDate       DateTime
  status        String    @default("PENDING") // PENDING, PAID, OVERDUE
  paidAt        DateTime?

  reminderSent   Boolean   @default(false)
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId, status])
  @@index([dueDate, status])
}

model SalePayment {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  amount        Float
  paymentMethod PaymentMethod @default(CASH)
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  receivedById  String?

  createdAt DateTime @default(now())
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum NotificationCategory {
  SYSTEM
  SECURITY
  BILLING
  SUPPORT
}

enum NotificationPriority {
  INFO
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id           String   @id @default(uuid())
  ticketNumber String   @unique
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  requesterName  String
  requesterEmail String
  requesterPhone String?
  requesterRole  String?        @default("Staff")
  subject        String
  description    String
  priority       TicketPriority @default(NORMAL)
  status         TicketStatus   @default(OPEN)

  relatedImei           String?
  relatedSerial         String?
  relatedVerificationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([status])
}

model AdminNotification {
  id          String               @id @default(uuid())
  title       String
  message     String
  category    NotificationCategory @default(SYSTEM)
  priority    NotificationPriority @default(NORMAL)
  isRead      Boolean              @default(false)
  actionUrl   String?
  actionLabel String?
  meta        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([category])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model VerificationLog {
  id         String    @id @default(uuid())
  identifier String
  status     String // "VERIFIED", "NOT_FOUND", "FLAGGED_STOLEN"
  ipAddress  String?
  userAgent  String?
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([businessId])
}

model TheftReport {
  id           String  @id @default(uuid())
  imei1        String
  imei2        String?
  serialNumber String?
  brand        String
  model        String
  color        String?

  ownerEmail   String
  ownerName    String
  ownerPhone   String
  lostNote     String?
  bountyAmount Float?  @default(0)

  status             TheftReportStatus @default(ACTIVE)
  verificationSource String            @default("GOOGLE_AUTH") // "GOOGLE_AUTH", "PROOF_SCREENSHOT", "POLICE_REPORT"
  proofUrl           String?
  policeCaseNo       String?

  resolvedAt   DateTime?
  resolvedNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([imei1])
  @@index([imei2])
  @@index([serialNumber])
  @@index([ownerEmail])
  @@index([status])
}

model DeviceCheckCache {
  id               String                  @id @default(uuid())
  imei             String                  @unique
  brand            String?
  model            String?
  carrierStatus    CarrierLockStatus?
  lockedCarrier    String?
  activationStatus DeviceActivationStatus?
  source           String                  @default("TAC_PARSER") // "TAC_PARSER", "LIVE_API", "SHOP_VERIFIED"
  rawData          Json?
  expiresAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([imei])
}

model ErrorLog {
  id         String   @id @default(uuid())
  endpoint   String?
  method     String?
  statusCode Int?
  errorType  String // e.g. "PrismaClientKnownRequestError", "TypeError", "HttpException"
  message    String // Error description
  stack      String? // Code stack trace
  businessId String?
  userEmail  String?
  createdAt  DateTime @default(now())

  @@index([errorType])
  @@index([statusCode])
  @@index([createdAt])
}

// Per-store running numbers for invoices, receipts, quotes and repair tickets.
model DocumentCounter {
  businessId String
  kind       String // "INVOICE", "RECEIPT", "REPAIR", "QUOTE-2026"
  value      Int    @default(0)

  @@id([businessId, kind])
}

// Fixed-window request counters. Lives in the database because the API runs on
// serverless instances that do not share memory.
model RateLimitBucket {
  key          String   @id
  count        Int      @default(0)
  windowEndsAt DateTime

  @@index([windowEndsAt])
}

// One pending email verification code per address (only a hash of the code is stored).
model EmailOtp {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

/// A device a customer gave the store: swapped in at checkout, or bought for cash.
/// Blocked attempts (device reported stolen) are kept too, so owners can see them.
model TradeIn {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  kind   TradeInKind
  status TradeInStatus @default(COMPLETED)

  // The sale the customer received a device in (SWAP only).
  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  // The device that came in, once it is in stock (empty for blocked attempts).
  phoneRecordId String?
  phoneRecord   PhoneRecord? @relation(fields: [phoneRecordId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // What was typed in, kept even if the device record changes later.
  deviceCategory DeviceCategory  @default(PHONE)
  imei1          String?
  imei2          String?
  serialNumber   String?
  brand          String?
  model          String?
  condition      PhoneCondition?

  customerName       String?
  customerPhone      String?
  idType             String?
  idNumber           String?
  ownershipConfirmed Boolean @default(false)

  tradeInValue  Float          @default(0)
  // Positive: the customer paid the store. Negative: the store paid the customer.
  balance       Float          @default(0)
  paymentMethod PaymentMethod?

  blockedReason String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([branchId])
  @@index([phoneRecordId])
  @@index([imei1])
  @@index([serialNumber])
}

/// A phone or computer that allowed NoxGuarda notifications (Web Push).
model PushSubscription {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?

  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([businessId])
  @@index([userId])
}

/// REMINDER: messages that take turns on a schedule. PLAN_EXPIRY: sent before a store's plan ends.
enum PushCampaignKind {
  REMINDER
  PLAN_EXPIRY
}

/// A reminder the admin sets up: what it says, who gets it and how often.
model PushCampaign {
  id   String           @id @default(uuid())
  name String
  kind PushCampaignKind @default(REMINDER)

  /// [{ "title": "...", "body": "...", "url": "/dashboard" }] — sent in turn.
  messages Json

  /// Plan codes that get it (FREE, STARTER, GOLD, ENTERPRISE). Empty = every plan.
  targetPlans String[] @default([])
  /// OWNERS, OWNERS_MANAGERS or ALL_STAFF
  audience    String   @default("OWNERS")

  /// Lagos times, "HH:MM". One send per time.
  timesOfDay       String[] @default([])
  /// 0 = Sunday … 6 = Saturday. Empty = every day.
  daysOfWeek       Int[]    @default([])
  /// PLAN_EXPIRY only: days before the plan ends, e.g. [3, 1].
  daysBeforeExpiry Int[]    @default([])

  isActive         Boolean   @default(true)
  nextMessageIndex Int       @default(0)
  lastSlotKey      String?
  sentCount        Int       @default(0)
  lastSentAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs PushLog[]
}

/// One send of a reminder (or a test), with how many devices received it.
model PushLog {
  id         String        @id @default(uuid())
  campaignId String?
  campaign   PushCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  businessId String?
  /// Stops the same plan-ending reminder going to a store twice.
  dedupeKey  String?       @unique
  title      String
  recipients Int           @default(0)
  delivered  Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([campaignId, createdAt])
}

/// Someone who markets NoxGuarda. Added by an admin; gets a free Gold store to demo with.
model Marketer {
  id              String    @id @default(uuid())
  email           String    @unique
  firstName       String
  lastName        String
  phone           String?
  /// INVITED (link sent, password not set yet) | ACTIVE | DISABLED
  status          String    @default("INVITED")
  tokenHash       String?   @unique
  inviteExpiresAt DateTime?
  businessId      String?   @unique
  business        Business? @relation("MarketerStore", fields: [businessId], references: [id], onDelete: SetNull)
  activatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  referrals MarketerReferral[]
}

/// A shop a marketer onboarded, by the owner's email. Linked to the store when it signs up.
model MarketerReferral {
  id              String    @id @default(uuid())
  marketerId      String
  marketer        Marketer  @relation(fields: [marketerId], references: [id], onDelete: Cascade)
  /// Lower-case. One marketer per shop: the first to add it.
  email           String    @unique
  shopName        String?
  phone           String?
  businessId      String?
  business        Business? @relation("ReferredStore", fields: [businessId], references: [id], onDelete: SetNull)
  /// The email already belonged to a store that had paid before it was added.
  alreadyCustomer Boolean   @default(false)
  linkedAt        DateTime?
  createdAt       DateTime  @default(now())

  @@index([marketerId])
  @@index([businessId])
}
